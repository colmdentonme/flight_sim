{
  "aircraft": "Fenix A320 CEO",
  "source": "\"Airbus A320 Summarised Checklist\" for the Fenix A320-200, by BritishAvgeek (same author as the PMDG 737 checklist used elsewhere in this app). Explicitly the CEO model (A320-200, not NEO). Published under a virtual airline's branding (\"Osprey Airways\"); only the checklist content itself was transcribed, not the livery/branding. \"Not to be used for any Real World Use - For home Flight Simulation Use Only\" per the source.",
  "groups": {
    "pre": {
      "label": "Pre-Flight / Ground",
      "color": "#0F9488"
    },
    "dep": {
      "label": "Departure",
      "color": "#1D72B8"
    },
    "air": {
      "label": "Airborne",
      "color": "#5A67A6"
    },
    "arr": {
      "label": "Arrival / Ground",
      "color": "#0F9488"
    }
  },
  "phases": [
    {
      "id": "pre-flight-before-start",
      "title": "PRE-FLIGHT / BEFORE START",
      "group": "pre",
      "items": [
        {
          "type": "item",
          "challenge": "Cockpit Preparations",
          "response": "Completed"
        },
        {
          "type": "item",
          "challenge": "Parking Brake",
          "response": "SET"
        },
        {
          "type": "item",
          "challenge": "GPU",
          "response": "Connected"
        },
        {
          "type": "item",
          "challenge": "EXT Power “Avail”",
          "response": "ON"
        },
        {
          "type": "item",
          "challenge": "BATT 1 & 2",
          "response": "On/Auto"
        },
        {
          "type": "marker",
          "text": "Check Voltage Sufficient"
        },
        {
          "type": "item",
          "challenge": "ADIRS",
          "response": "NAV"
        },
        {
          "type": "item",
          "challenge": "EVAC",
          "response": "Set Capt/Purs"
        },
        {
          "type": "item",
          "challenge": "Signs",
          "response": "On/Auto"
        },
        {
          "type": "item",
          "challenge": "Lights",
          "response": "As Required"
        },
        {
          "type": "item",
          "challenge": "Crew Oxygen",
          "response": "ON"
        },
        {
          "type": "item",
          "challenge": "Fuel Pumps",
          "response": "ON"
        },
        {
          "type": "item",
          "challenge": "GEN 1 & 2",
          "response": "ON / “FAULT”"
        },
        {
          "type": "item",
          "challenge": "Cockpit/Cabin Heat",
          "response": "As Required"
        },
        {
          "type": "item",
          "challenge": "Pack 1 & 2",
          "response": "ON / “FAULT”"
        },
        {
          "type": "item",
          "challenge": "Lights",
          "response": "As Required"
        },
        {
          "type": "item",
          "challenge": "Signs",
          "response": "On/Auto"
        },
        {
          "type": "item",
          "challenge": "Warning/Caution/Fire/Oxygen Tests",
          "response": "Completed"
        },
        {
          "type": "item",
          "challenge": "EMER Exit Lights",
          "response": "ARM"
        },
        {
          "type": "item",
          "challenge": "Ice Ind/STBY Compass",
          "response": "On"
        },
        {
          "type": "item",
          "challenge": "Cargo Heat",
          "response": "As Required"
        },
        {
          "type": "marker",
          "text": "Set FMC / MCDU / Obtain Clearance"
        },
        {
          "type": "item",
          "challenge": "Altimeter",
          "response": "SET"
        },
        {
          "type": "item",
          "challenge": "Transponder",
          "response": "SET"
        },
        {
          "type": "item",
          "challenge": "PWS",
          "response": "Set AUTO"
        },
        {
          "type": "item",
          "challenge": "GCS",
          "response": "Set AUTO"
        },
        {
          "type": "item",
          "challenge": "Fueling / Loading / Boarding",
          "response": "Completed"
        },
        {
          "type": "item",
          "challenge": "APU Master",
          "response": "On – Wait 3sec"
        },
        {
          "type": "item",
          "challenge": "APU",
          "response": "START"
        },
        {
          "type": "item",
          "challenge": "APU Bleed “AVAIL”",
          "response": "Bleed ON"
        },
        {
          "type": "item",
          "challenge": "EXT Pwr",
          "response": "OFF"
        },
        {
          "type": "item",
          "challenge": "Take Off Data",
          "response": "SET"
        },
        {
          "type": "item",
          "challenge": "FCU",
          "response": "SET"
        },
        {
          "type": "marker",
          "text": "Departure – Briefed & Checked"
        },
        {
          "type": "item",
          "challenge": "Flight Directors",
          "response": "ON"
        },
        {
          "type": "item",
          "challenge": "Radios",
          "response": "Frequencies SET"
        }
      ]
    },
    {
      "id": "engine-start",
      "title": "ENGINE START",
      "group": "dep",
      "items": [
        {
          "type": "marker",
          "text": "Doors Closed / Gnd Equip. Clear / Chocks Away"
        },
        {
          "type": "action",
          "text": "Request Push & Start Clearance"
        },
        {
          "type": "item",
          "challenge": "Beacon Light",
          "response": "ON"
        },
        {
          "type": "item",
          "challenge": "Fuel Pumps",
          "response": "Confirm ON"
        },
        {
          "type": "item",
          "challenge": "Ignition Mode Selector",
          "response": "Set IGN/START"
        },
        {
          "type": "item",
          "challenge": "ENG 2 Switch",
          "response": "ON"
        },
        {
          "type": "marker",
          "text": "Repeat for ENG 1 – Then when stable:"
        },
        {
          "type": "item",
          "challenge": "GENs 1 & 2",
          "response": "ON (No Fault)"
        },
        {
          "type": "item",
          "challenge": "Ignition Mode Selector",
          "response": "Set NORM"
        },
        {
          "type": "item",
          "challenge": "Probe Heat",
          "response": "On/AUTO"
        },
        {
          "type": "item",
          "challenge": "Wing / Engine Anti-Ice",
          "response": "As Required"
        },
        {
          "type": "item",
          "challenge": "Pack 1 & 2",
          "response": "On (No Fault)"
        },
        {
          "type": "item",
          "challenge": "FLAPS",
          "response": "As Required"
        },
        {
          "type": "item",
          "challenge": "Trim",
          "response": "As Required"
        },
        {
          "type": "item",
          "challenge": "Flight Controls",
          "response": "Full & Free"
        },
        {
          "type": "item",
          "challenge": "APU Bleed & APU",
          "response": "OFF"
        },
        {
          "type": "item",
          "challenge": "FCP",
          "response": "Set for Departure"
        },
        {
          "type": "item",
          "challenge": "Engine Instruments",
          "response": "Checked"
        },
        {
          "type": "action",
          "text": "Request Taxi"
        }
      ]
    },
    {
      "id": "taxi",
      "title": "TAXI",
      "group": "dep",
      "items": [
        {
          "type": "item",
          "challenge": "Nose Lights",
          "response": "Taxi"
        },
        {
          "type": "item",
          "challenge": "Autobrake",
          "response": "Set MAX"
        },
        {
          "type": "marker",
          "text": "Check Compass / Gyro"
        },
        {
          "type": "item",
          "challenge": "Ground Spoilers",
          "response": "ARM"
        },
        {
          "type": "item",
          "challenge": "T.O CONFIG",
          "response": "NO BLUE"
        }
      ]
    },
    {
      "id": "pre-departure",
      "title": "PRE-DEPARTURE (at the hold)",
      "group": "dep",
      "items": [
        {
          "type": "item",
          "challenge": "Vspeeds",
          "response": "Check"
        },
        {
          "type": "item",
          "challenge": "FCP / Nav Data / Radios",
          "response": "Check"
        },
        {
          "type": "action",
          "text": "Obtain Take-Off Clearance – Alert Cabin Crew"
        }
      ]
    },
    {
      "id": "takeoff",
      "title": "TAKEOFF",
      "group": "dep",
      "items": [
        {
          "type": "item",
          "challenge": "Nose Lights",
          "response": "TO"
        },
        {
          "type": "item",
          "challenge": "STROBES",
          "response": "ON"
        },
        {
          "type": "item",
          "challenge": "Runway Turnoff Lights",
          "response": "ON"
        },
        {
          "type": "item",
          "challenge": "Landing Lights",
          "response": "ON"
        },
        {
          "type": "item",
          "challenge": "Transponder",
          "response": "Set TA/RA & ON"
        },
        {
          "type": "item",
          "challenge": "Clock",
          "response": "START"
        },
        {
          "type": "item",
          "challenge": "Runway",
          "response": "Confirm"
        }
      ]
    },
    {
