        {
          "type": "item",
          "challenge": "Radios",
          "response": "SET"
        },
        {
          "type": "item",
          "challenge": "Wing / Engine Anti-Ice",
          "response": "As Required"
        },
        {
          "type": "item",
          "challenge": "FCP",
          "response": "As Required"
        },
        {
          "type": "item",
